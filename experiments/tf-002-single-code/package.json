{
  "name": "optilink-tf-002-single-code",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "lab": "node lab-server.mjs",
    "lab:tunnel": "node lab-tunnel.mjs",
    "lab:tunnel:fountain": "OPTILINK_LAB_PAGE=fountain node lab-tunnel.mjs",
    "lab:tunnel:optigrid": "OPTILINK_LAB_PAGE=optigrid node lab-tunnel.mjs",
    "lab:tunnel:tiled": "OPTILINK_LAB_PAGE=tiled node lab-tunnel.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "node --test src/*.test.ts",
    "bench:headless": "playwright test carrier-bench.spec.mjs --config=playwright.config.mjs --reporter=line",
    "bench:tiled": "playwright test tiled-carrier.spec.mjs --config=playwright.config.mjs --reporter=line",
    "bench:temporal": "playwright test tiled-temporal.spec.mjs --config=playwright.config.mjs --reporter=line"
  },
  "dependencies": {
    "@zxing/browser": "0.2.1",
    "qrcode": "1.5.4",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/qrcode": "1.5.6",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
