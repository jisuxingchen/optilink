<view class="page">
  <view class="banner">OptiLink · OPTICAL CAMERA FRAME — LOCAL ONLY</view>
  <view class="bootbanner {{bootStatus === 'BOOT OK' ? 'bootok' : 'booterr'}}">{{bootStatus}} · buildId {{buildId}}{{bootError ? ' · ' + bootError : ''}}</view>
  <view class="netbanner">Network payload path: NONE</view>
  <view class="receivebanner" wx:if="{{mode === 'receive'}}">SHARED RECEIVE PIPELINE ACTIVE · buildId {{buildId}}</view>
  <view class="benchbanner" wx:if="{{mode === 'baseline'}}">SINGLE-CODE BASELINE 单码基线 ACTIVE · buildId {{buildId}}</view>
  <view class="benchbanner" wx:if="{{mode === 'benchmark'}}">CAMERA BENCHMARK MODE ACTIVE · buildId {{buildId}}</view>

  <camera
    device-position="back"
    flash="off"
    resolution="high"
    frame-size="large"
    class="camera"
    bindinitdone="onInitDone"
    bindstop="onCameraStop"
    binderror="onCameraError"
  />

  <view class="controls">
    <button class="btn primary" bindtap="startCamera" disabled="{{running}}">Start Camera</button>
    <button class="btn" bindtap="stopCamera" disabled="{{!running}}">Stop Camera</button>
    <button class="btn" bindtap="resetMetrics">Reset Metrics</button>
    <button class="btn modebtn {{mode === 'receive' ? 'modeactive' : ''}}" data-mode="receive" bindtap="onSelectMode">Shared Receive Pipeline</button>
    <button class="btn modebtn {{mode === 'baseline' ? 'modeactive' : ''}}" data-mode="baseline" bindtap="onSelectMode">Single-Code Baseline 单码基线</button>
    <button class="btn modebtn {{mode === 'benchmark' ? 'modeactive' : ''}}" data-mode="benchmark" bindtap="onSelectMode">Camera Benchmark</button>
    <button class="btn" wx:if="{{mode === 'benchmark'}}" bindtap="toggleHeavy">{{heavy ? 'Normalization 1280x720: ON' : 'Normalization 1280x720: OFF'}}</button>
  </view>

  <view class="panel">
    <view class="section">status</view>
    <view class="row"><text class="k">camera permission</text><text class="v">{{permissionStatus}}</text></view>
    <view class="row"><text class="k">buildId</text><text class="v">{{buildId}}</text></view>
    <view class="row"><text class="k">active mode</text><text class="v">{{mode}}</text></view>
    <view class="row"><text class="k">camera running</text><text class="v">{{running ? 'running' : 'stopped'}}</text></view>
    <view class="row"><text class="k">frame callback</text><text class="v">{{callbackActive ? 'active' : 'inactive'}}</text></view>
    <view class="row"><text class="k">maxZoom</text><text class="v">{{maxZoom}}</text></view>
  </view>

  <view class="panel">
    <view class="section">live frame metrics</view>
    <view class="row"><text class="k">frame</text><text class="v">{{frameWidth}} × {{frameHeight}}</text></view>
    <view class="row"><text class="k">frame format</text><text class="v">{{frameFormat}}</text></view>
    <view class="row"><text class="k">frame buffer bytes</text><text class="v">{{frameBufferBytes}}</text></view>
    <view class="row"><text class="k">callback FPS</text><text class="v">{{callbackFps}}</text></view>
    <view class="row"><text class="k">processing FPS</text><text class="v">{{processingFps}}</text></view>
    <view class="row"><text class="k">total received frames</text><text class="v">{{totalReceived}}</text></view>
    <view class="row"><text class="k">processed frames</text><text class="v">{{processed}}</text></view>
    <view class="row"><text class="k">skipped / dropped</text><text class="v">{{skipped}}</text></view>
    <view class="row"><text class="k">skip ratio</text><text class="v">{{skipRatio}}</text></view>
    <view class="row"><text class="k">avg process time</text><text class="v">{{avgProcessMs}}</text></view>
    <view class="row"><text class="k">p95 process time</text><text class="v">{{p95ProcessMs}}</text></view>
    <view class="row"><text class="k">data ingress</text><text class="v">{{ingressMBps}} MB/s</text></view>
  </view>

  <view class="panel" wx:if="{{mode === 'receive'}}">
    <view class="section">shared receive pipeline</view>
    <view class="pipeline-error" wx:if="{{receivePipelineError}}">{{receivePipelineError}}</view>
    <view class="row"><text class="k">self-check</text><text class="v">{{receiveSelfCheck}}</text></view>
    <view class="row"><text class="k">product state</text><text class="v">{{productStage}}</text></view>
    <view class="row"><text class="k">file</text><text class="v">{{fileName}}</text></view>
    <view class="row"><text class="k">stage</text><text class="v">{{receiveStage}}</text></view>
    <view class="row"><text class="k">selected transform</text><text class="v">{{receiveSelectedTransform}}</text></view>
    <view class="row"><text class="k">triplet valid</text><text class="v">{{receiveTripletValid}}</text></view>
    <view class="row"><text class="k">locator support</text><text class="v">{{receiveSupport}}</text></view>
    <view class="row"><text class="k">exact tiles</text><text class="v">{{receiveExactTiles}}</text></view>
    <view class="row"><text class="k">manifest</text><text class="v">{{manifestStatus}}</text></view>
    <view class="row"><text class="k">manifest file size</text><text class="v">{{manifestFileSize}}</text></view>
    <view class="row"><text class="k">beacon detections</text><text class="v">{{beaconDetections}}</text></view>
    <view class="row"><text class="k">orientation attempts</text><text class="v">{{orientationAttempts}}</text></view>
    <view class="row"><text class="k">orientation success</text><text class="v">{{orientationSuccess}}</text></view>
    <view class="row"><text class="k">manifest acquisitions</text><text class="v">{{manifestAcquisitions}}</text></view>
    <view class="row"><text class="k">preamble attempts</text><text class="v">{{preambleAttempts}}</text></view>
    <view class="row"><text class="k">preamble success</text><text class="v">{{preambleSuccess}}</text></view>
    <view class="row"><text class="k">preamble rejected/skipped</text><text class="v">{{preambleRejected}}</text></view>
    <view class="row"><text class="k">last stage transition</text><text class="v">{{lastStageTransition}} {{lastStageTransitionAt}}</text></view>
    <view class="row"><text class="k">decoded symbols</text><text class="v">{{decodedSymbols}}</text></view>
    <view class="row"><text class="k">duplicates</text><text class="v">{{duplicates}}</text></view>
    <view class="row"><text class="k">redundant</text><text class="v">{{redundant}}</text></view>
    <view class="row"><text class="k">rejected</text><text class="v">{{rejected}}</text></view>
    <view class="row"><text class="k">replaced (bounded slot)</text><text class="v">{{replaced}}</text></view>
    <view class="row"><text class="k">solved blocks</text><text class="v">{{solvedBlocks}}</text></view>
    <view class="row"><text class="k">reconstruction</text><text class="v">{{reconstructionStatus}}</text></view>
    <view class="row"><text class="k">reconstruct ms</text><text class="v">{{reconstructionMs}}</text></view>
    <view class="row"><text class="k">SHA-256</text><text class="v">{{shaStatus}}</text></view>
    <view class="row"><text class="k">SHA ms</text><text class="v">{{shaMs}}</text></view>
    <view class="row"><text class="k">file write ms</text><text class="v">{{fileWriteMs}}</text></view>
    <view class="row"><text class="k">network radio type</text><text class="v">{{networkType}}</text></view>
    <view class="row"><text class="k">local file</text><text class="v">{{localFilePath}}</text></view>
    <view class="row" wx:for="{{tileStatus}}" wx:key="*this"><text class="k">per-tile</text><text class="v">{{item}}</text></view>
  </view>

  <view class="panel" wx:if="{{mode === 'baseline'}}">
    <view class="section">single-code baseline 单码基线</view>
    <view class="pipeline-error" wx:if="{{baselinePipelineError}}">{{baselinePipelineError}}</view>
    <view class="row"><text class="k">self-check</text><text class="v">{{baselineSelfCheck}}</text></view>
    <view class="row"><text class="k">Mode / 模式</text><text class="v">Single-Code Baseline / 单码基线</text></view>
    <view class="row"><text class="k">Status / 状态</text><text class="v">{{baselineStatus}}</text></view>
    <view class="row"><text class="k">File ID / 文件ID</text><text class="v">{{baselineFileId}}</text></view>
    <view class="row"><text class="k">File / 文件</text><text class="v">{{baselineFileName}}</text></view>
    <view class="row"><text class="k">File size / 文件大小</text><text class="v">{{baselineFileSize}}</text></view>
    <view class="row"><text class="k">Received chunks / 已接收分片</text><text class="v">{{baselineReceivedChunks}}</text></view>
    <view class="row"><text class="k">Missing chunks / 缺失分片</text><text class="v">{{baselineMissingChunks}}</text></view>
    <view class="row"><text class="k">Duplicates / 重复帧</text><text class="v">{{baselineDuplicates}}</text></view>
    <view class="row"><text class="k">Last chunk / 最后收到</text><text class="v">{{baselineLastChunk}}</text></view>
    <view class="row"><text class="k">Elapsed / 已用时</text><text class="v">{{baselineElapsed}}</text></view>
    <view class="row"><text class="k">Camera FPS / 相机帧率</text><text class="v">{{callbackFps}}</text></view>
    <view class="row"><text class="k">Processed FPS</text><text class="v">{{processingFps}}</text></view>
    <view class="row"><text class="k">Camera frame / 相机帧</text><text class="v">{{baselineFrameInfo}}</text></view>
    <view class="row"><text class="k">Decode attempts / 解码尝试</text><text class="v">{{baselineDecodeAttempts}}</text></view>
    <view class="row"><text class="k">Decode success / 解码成功</text><text class="v">{{baselineDecodeSuccess}}</text></view>
    <view class="row"><text class="k">CRC failures / CRC 失败</text><text class="v">{{baselineCrcFailures}}</text></view>
    <view class="row"><text class="k">Locate failures / 定位失败</text><text class="v">{{baselineLocateFailures}}</text></view>
    <view class="row"><text class="k">Metadata rejects</text><text class="v">{{baselineMetadataRejects}}</text></view>
    <view class="row"><text class="k">Foreign file rejects</text><text class="v">{{baselineForeignRejects}}</text></view>
    <view class="row"><text class="k">Code size / 码尺寸</text><text class="v">{{baselineCodeWidth}}</text></view>
    <view class="row"><text class="k">Pixels per cell X/Y</text><text class="v">{{baselinePixPerCell}}</text></view>
    <view class="row"><text class="k">Reserved pattern score</text><text class="v">{{baselineReservedScore}}</text></view>
    <view class="row"><text class="k">Frame rotation index</text><text class="v">{{baselineRotation}}</text></view>
    <view class="row"><text class="k">Contrast</text><text class="v">{{baselineContrast}}</text></view>
    <view class="row"><text class="k">Time to first chunk</text><text class="v">{{baselineFirstChunkMs}}</text></view>
    <view class="row"><text class="k">Time to all chunks</text><text class="v">{{baselineAllChunksMs}}</text></view>
    <view class="row"><text class="k">Reconstruction / 重构方式</text><text class="v">{{baselineReconstructMethod}}</text></view>
    <view class="row"><text class="k">Reconstruction / 重构结果</text><text class="v">{{baselineReconstructionStatus}}</text></view>
    <view class="row"><text class="k">Reconstruct ms</text><text class="v">{{baselineReconstructMs}}</text></view>
    <view class="row"><text class="k">SHA-256</text><text class="v">{{baselineShaStatus}}</text></view>
    <view class="row"><text class="k">SHA ms</text><text class="v">{{baselineShaMs}}</text></view>
    <view class="row"><text class="k">network radio type</text><text class="v">{{networkType}}</text></view>
    <view class="row"><text class="k">file save</text><text class="v">not required in this baseline / 基线不落盘</text></view>
  </view>

  <view class="panel" wx:if="{{mode === 'baseline'}}">
    <view class="section">speed ladder · 速度阶梯 (TF-012 r6)</view>
    <view class="row"><text class="k">declared hold / 声明每码停留</text><text class="v">{{holdMsDeclared}} ms</text></view>
    <view class="row">
      <text class="k">set to sender ?holdMs=</text>
      <input class="numinput" type="number" value="{{holdMsInput}}" bindinput="onHoldMsInput" placeholder="1500 .. 33" />
    </view>
    <view class="row">
      <text class="k">ladder preset / 阶梯预设</text>
      <picker mode="selector" range="{{holdMsLadder}}" bindchange="onHoldMsPick">
        <view class="pick">pick {{holdMsDeclared}} ms ▾</view>
      </picker>
    </view>
    <view class="row"><text class="k">theoretical chunk rate / 理论切片速率</text><text class="v">{{theoChunkRate}}</text></view>
    <view class="row"><text class="k">theoretical file-payload rate / 理论文件载荷速率</text><text class="v">{{theoPayloadRate}}</text></view>
    <view class="note">declared sender-side arithmetic · NOT Net Goodput · NOT optical throughput</view>
    <view class="hr"></view>
    <view class="row"><text class="k">active process avg / 有效处理均值</text><text class="v">{{activeProcessAvgMs}}</text></view>
    <view class="row"><text class="k">active process p50</text><text class="v">{{activeProcessP50Ms}}</text></view>
    <view class="row"><text class="k">active process p95</text><text class="v">{{activeProcessP95Ms}}</text></view>
    <view class="row"><text class="k">active process max</text><text class="v">{{activeProcessMaxMs}}</text></view>
    <view class="row"><text class="k">active samples / 有效样本</text><text class="v">{{activeProcessSamples}}</text></view>
    <view class="row"><text class="k">post-complete frames EXCLUDED / 完成后忽略帧</text><text class="v">{{postCompleteFrames}}</text></view>
    <view class="row"><text class="k">clock / 时钟</text><text class="v">{{clockSource}}</text></view>
    <view class="hr"></view>
    <view class="row"><text class="k">exploratory Net Goodput / 探索性净吞吐</text><text class="v">{{netGoodputText}}</text></view>
    <view class="note">defined ONLY when 16/16 unique chunks + SHA-256 MATCH · 10 KiB exploratory physical benchmark · NOT G0</view>
    <view class="hr"></view>
    <view class="row"><text class="k">CameraFrames/code (theoretical)</text><text class="v">{{theoreticalCameraFramesPerCode}}</text></view>
    <view class="row"><text class="k">decode success ratio</text><text class="v">{{decodeSuccessRatio}}</text></view>
    <view class="row"><text class="k">CRC failure ratio</text><text class="v">{{crcFailureRatio}}</text></view>
    <view class="row"><text class="k">locate failure ratio</text><text class="v">{{locateFailureRatio}}</text></view>
    <view class="row"><text class="k">new unique chunk yield</text><text class="v">{{newUniqueChunkYield}}</text></view>
    <view class="row"><text class="k">duplicate ratio</text><text class="v">{{duplicateRatio}}</text></view>
    <view class="note">diagnostic only — ranks PASSing points, does NOT decide PASS · NOT decode opportunities</view>
  </view>

  <view class="panel" wx:if="{{mode === 'baseline' && baselineContentPreview}}">
    <view class="section">TRANSFER COMPLETE / 传输完成 — Content Preview / 内容预览</view>
    <view class="row"><text class="k">lines</text><text class="v">{{baselinePreviewLines}}</text></view>
    <text class="preview">{{baselineContentPreview}}</text>
  </view>

  <view class="panel" wx:if="{{mode === 'baseline'}}">
    <view class="section">G7 locator diagnostics · G7 定位诊断</view>
    <view class="row"><text class="k">deepest stage / 最深阶段</text><text class="v">{{g7Stage}}</text></view>
    <view class="row"><text class="k">stage reason / 阶段原因</text><text class="v">{{g7StageReason}}</text></view>
    <view class="hr"></view>
    <view class="row"><text class="k">G7a Candidate Detection / 候选区域检测</text><text class="v">{{g7aPass}}</text></view>
    <view class="row"><text class="k">G7a frames pass / 通过帧数</text><text class="v">{{g7aCount}}</text></view>
    <view class="row"><text class="k">frame luma min/max/mean</text><text class="v">{{g7aLuma}}</text></view>
    <view class="row"><text class="k">contrast / 对比度</text><text class="v">{{g7aContrast}}</text></view>
    <view class="row"><text class="k">binarisation threshold / 二值化阈值</text><text class="v">{{g7aThreshold}}</text></view>
    <view class="row"><text class="k">dark pixel ratio / 暗像素比例</text><text class="v">{{g7aDarkRatio}}</text></view>
    <view class="row"><text class="k">local variation / 局部起伏</text><text class="v">{{g7aLocalVariation}}</text></view>
    <view class="row"><text class="k">channel means R/G/B/A</text><text class="v">{{g7aChannels}}</text></view>
    <view class="row"><text class="k">dark components / 连通域数</text><text class="v">{{g7aComponents}}</text></view>
    <view class="row"><text class="k">candidates / 候选区域数</text><text class="v">{{g7aCandidates}}</text></view>
    <view class="row"><text class="k">candidate spans / 候选尺寸</text><text class="v">{{g7aCandidateSpans}}</text></view>
    <view class="row"><text class="k">largest region / 最大暗区</text><text class="v">{{g7aLargestBox}}</text></view>
    <view class="row"><text class="k">bright re-segmentation</text><text class="v">{{g7aBrightRegion}}</text></view>
    <view class="row"><text class="k">G7a rejection / 拒绝原因</text><text class="v">{{g7aRejection}}</text></view>
    <view class="hr"></view>
    <view class="row"><text class="k">G7b Code Bounding Box / 码边界定位</text><text class="v">{{g7bPass}}</text></view>
    <view class="row"><text class="k">G7b reason / 判定依据</text><text class="v">{{g7bReason}}</text></view>
    <view class="hr"></view>
    <view class="row"><text class="k">G7c Geometry Lock / 几何锁定</text><text class="v">{{g7cPass}}</text></view>
    <view class="row"><text class="k">seeds / 粗定位种子</text><text class="v">{{g7cSeeds}}</text></view>
    <view class="row"><text class="k">best seed score / 最佳粗分</text><text class="v">{{g7cBestSeed}}</text></view>
    <view class="row"><text class="k">refined attempts / 精定位次数</text><text class="v">{{g7cRefined}}</text></view>
    <view class="row"><text class="k">best refined score (incl. failed) / 最佳精分</text><text class="v">{{g7cBestRefined}}</text></view>
    <view class="row"><text class="k">geometry / 几何</text><text class="v">{{g7cGeometry}}</text></view>
    <view class="row"><text class="k">G7c reason / 失败原因</text><text class="v">{{g7cReason}}</text></view>
    <view class="hr"></view>
    <view class="row"><text class="k">G7d OptiGrid CRC Decode / CRC 解码</text><text class="v">{{g7dPass}}</text></view>
    <view class="row"><text class="k">CRC attempts/ok/fail</text><text class="v">{{g7dCrc}}</text></view>
    <view class="row"><text class="k">decoded sequence / 序列号</text><text class="v">{{g7dSequence}}</text></view>
    <view class="row"><text class="k">decoded chunkIndex / 切片号</text><text class="v">{{g7dChunkIndex}}</text></view>
  </view>

  <view class="panel" wx:if="{{mode === 'benchmark'}}">
    <view class="section">luminance / contrast (sampled pixels)</view>
    <view class="row"><text class="k">mean luma</text><text class="v">{{meanLuma}}</text></view>
    <view class="row"><text class="k">min luma</text><text class="v">{{minLuma}}</text></view>
    <view class="row"><text class="k">max luma</text><text class="v">{{maxLuma}}</text></view>
    <view class="row"><text class="k">contrast range</text><text class="v">{{contrastRange}}</text></view>
  </view>

  <view class="panel" wx:if="{{mode === 'benchmark' && heavy}}">
    <view class="section">1280×720 normalization benchmark</view>
    <view class="row"><text class="k">average</text><text class="v">{{normalizeAvgMs}}</text></view>
    <view class="row"><text class="k">p95</text><text class="v">{{normalizeP95Ms}}</text></view>
    <view class="row"><text class="k">effective FPS</text><text class="v">{{normalizeFps}}</text></view>
    <view class="row"><text class="k">samples</text><text class="v">{{normalizeSamples}}</text></view>
  </view>

  <view class="panel">
    <view class="section">Physical Device Evidence</view>
    <view class="row"><text class="k">timestamp</text><text class="v">{{deviceTimestamp}}</text></view>
    <view class="row"><text class="k">model</text><text class="v">{{model}}</text></view>
    <view class="row"><text class="k">brand</text><text class="v">{{brand}}</text></view>
    <view class="row"><text class="k">system</text><text class="v">{{system}}</text></view>
    <view class="row"><text class="k">platform</text><text class="v">{{platform}}</text></view>
    <view class="row"><text class="k">pixel ratio</text><text class="v">{{pixelRatio}}</text></view>
    <view class="row"><text class="k">screen</text><text class="v">{{screenSize}}</text></view>
    <view class="row"><text class="k">WeChat version</text><text class="v">{{wechatVersion}}</text></view>
    <view class="row"><text class="k">base library</text><text class="v">{{baseLibVersion}}</text></view>
    <view class="row"><text class="k">SDK</text><text class="v">{{sdkVersion}}</text></view>
  </view>

  <view class="panel" wx:if="{{errors.length}}">
    <view class="section">errors / warnings ({{errors.length}})</view>
    <view class="err" wx:for="{{errors}}" wx:key="*this">{{item}}</view>
  </view>

  <view class="controls">
    <button class="btn" bindtap="freezeResult">Freeze Test Result</button>
    <button class="btn" bindtap="copyResult" disabled="{{!frozenResult}}">Copy Result</button>
  </view>

  <view class="panel" wx:if="{{frozenResult}}">
    <view class="section">frozen result ({{frozenAt}})</view>
    <text class="frozen" selectable="true">{{frozenResult}}</text>
  </view>

  <view class="log">{{log}}</view>
</view>
