<view class="page">
  <view class="topstrip">
    <text class="tsid">OptiLink · TF-012 v2</text>
    <text class="tsbuild">buildId {{buildId}}</text>
    <text class="tsnet">payload path NONE</text>
    <text class="{{bootStatus === 'BOOT OK' ? 'tsok' : 'tsbad'}}">{{bootStatus}}{{bootError ? ' · ' + bootError : ''}}</text>
  </view>

  <camera
    device-position="back"
    flash="off"
    resolution="high"
    frame-size="large"
    class="camera"
    bindinitdone="onInitDone"
    bindstop="onCameraStop"
    binderror="onCameraError"
  />

  <view class="simple">
    <view class="srow">
      <text class="sk">Camera / 相机</text>
      <text class="sv {{simpleCameraLabel === 'READY / 就绪' ? 'svok' : 'svbad'}}">{{simpleCameraLabel}}</text>
    </view>
    <view class="srow">
      <text class="sk">T1 STATIC READY</text>
      <text class="sv {{simpleStaticReady ? 'svok' : 'svbad'}}">{{simpleStaticLabel}}</text>
    </view>

    <view class="step">1 · PC sender: open static chunk 0 directly (?diagnostic=chunk0). Keep the whole carrier visible.</view>
    <button class="sbtn sbtn2" bindtap="onSimpleStaticCheck" disabled="{{simpleStatus === 'RECEIVING'}}">
      CHECK STATIC READY / 静态预检
    </button>

    <view class="step">2 · When READY: keep phone fixed, switch PC sender to cyclic 1000 ms, then start the file test.</view>
    <button class="sbtn" bindtap="onSimpleStart" disabled="{{simpleStatus === 'RECEIVING' || !simpleStaticReady}}">
      START FILE TEST / 开始文件测试
    </button>

    <view class="sbig">Progress / 进度: {{simpleProgress}}</view>
    <view class="sline">Decode: {{simpleDecode}}</view>
    <view class="sline">Elapsed / 用时: {{simpleElapsed}}</view>
    <view class="sline">T2 consecutive PASS / 连续通过: {{simplePassStreak}}</view>

    <view class="sres {{simpleResultClass}}">Result / 结果: {{simpleResult}}</view>
    <view class="sdetail">{{simpleDetail}}</view>
    <view class="spass" wx:if="{{simpleResult === 'PASS'}}">
      <text class="svok">{{simplePassBytes}} · {{simplePassElapsed}} · {{simplePassSha}}</text>
    </view>

    <view class="sbtns">
      <button class="sbtn sbtn2" bindtap="onSimpleAgain" disabled="{{simpleStatus === 'RECEIVING'}}">RUN AGAIN / 再跑一次</button>
      <button class="sbtn sbtn2" bindtap="onSimpleCopy">COPY RESULT / 复制结果</button>
    </view>

    <view class="snote">T1 = 10 CRC-valid chunk-0 decodes / 2 s · T2 = 16/16 + 10240 B + local SHA MATCH / 40 s · need 3 consecutive T2 PASS · network payload path NONE</view>
  </view>
</view>
